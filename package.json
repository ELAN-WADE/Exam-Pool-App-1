{
  "name": "exampool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun --env-file=.env server.ts\" \"cd frontend && bun run dev\"",
    "postinstall": "cd frontend && bun install",
    "build": "cd frontend && bun run build",
    "start": "bun --env-file=.env server.ts",
    "setup": "cd frontend && bun install"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "dns2": "^3.0.0",
    "pdf-parse": "^2.4.5"
  }
}
